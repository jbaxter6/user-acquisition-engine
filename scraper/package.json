{
  "name": "outreach-scraper",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx --env-file=.env src/index.ts",
    "chrome": "open -na \"Google Chrome\" --args --remote-debugging-port=9222 --user-data-dir=$HOME/.outreach-chrome https://www.tiktok.com",
    "list": "npm run scrape -- --list",
    "all": "npm run scrape -- --all"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
