# The CRM. Local dev or production.
CRM_URL=http://localhost:5173
# Omit when the server has no SITE_PASSWORD.
CRM_PASSWORD=

# instagram, tiktok, or youtube
PLATFORM=instagram
# Exact name from the Templates page.
TEMPLATE_NAME=Intro

# 1–20. A normal run is 10–20. Use 1 the first time.
BATCH_SIZE=10

# Gap between people. Both must be at least 15000.
MIN_DELAY_MS=45000
MAX_DELAY_MS=90000

# Walk the CRM and open each tab, but do not paste or send.
DRY_RUN=false

# Extra accounts that must never send. These two are always blocked.
# BLOCKED_HANDLES=someotheraccount

# Same Chrome the scraper uses.
# CHROME_CDP=http://127.0.0.1:9222
