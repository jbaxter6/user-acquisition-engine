# From the Meta app's Instagram product page ("API setup with Instagram
# login" tab) — NOT the top-level Facebook App ID under App Settings > Basic.
# Required for the "Connect Instagram" login flow (routes/auth.ts).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must exactly match a redirect URI registered on the Instagram product's
# "API setup with Instagram login" page.
OAUTH_REDIRECT_URI=http://localhost:4000/auth/instagram/callback
# Where the frontend runs — the callback redirects back here when done.
CLIENT_URL=http://localhost:5173

# Arbitrary string you choose; must match the value entered in the app's
# webhook subscription config (for receiving messages).
INSTAGRAM_VERIFY_TOKEN=

PORT=4000
